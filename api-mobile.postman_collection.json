{
  "info": {
    "_postman_id": "b6e2f1c0-6f3a-4a2b-9b1a-api-mobile-0001",
    "name": "api-mobile",
    "description": "Coleccion de la API REST api-mobile: autenticacion (login) y modulos de usuarios, clientes y productos (con subida de imagenes).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "usuario_id", "value": "", "type": "string" },
    { "key": "cliente_id", "value": "", "type": "string" },
    { "key": "producto_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token automaticamente en la variable de coleccion {{token}}",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('token', data.token);",
                  "        if (data.usuario && data.usuario.id) {",
                  "            pm.collectionVariables.set('usuario_id', data.usuario.id);",
                  "        }",
                  "    }",
                  "}",
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica un usuario y devuelve un token JWT. El token se guarda automaticamente en la variable {{token}} para usarlo en el resto de las peticiones."
          },
          "response": []
        }
      ]
    },
