              ]
            },
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": ["{{base_url}}"],
              "path": ["api", "productos"]
            },
            "description": "Requiere token. Body tipo form-data. El campo 'imagen' debe ser de tipo File (jpg, jpeg, png, gif o webp, maximo 5MB). La respuesta incluye la URL publica de la imagen guardada."
          },
          "response": []
